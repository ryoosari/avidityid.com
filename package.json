{
  "name": "avidityid-website",
  "version": "1.0.0",
  "description": "Modern static website framework for Avidity Id with article management and digital download sales",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run process-content && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "process-content": "node scripts/process-articles.js && node scripts/process-products.js",
    "validate-content": "node scripts/validate-content.js",
    "new-article": "node scripts/create-article.js",
    "new-product": "node scripts/create-product.js",
    "netlify-build": "npm run process-content && next build",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.0.18",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.11.17",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "marked": "^9.1.2",
    "next": "^15.5.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reading-time": "^1.5.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.4.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.33",
    "@types/react-dom": "^18.2.14",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.52.0",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
